[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/market_ui.gd" id="1_market"]
[ext_resource type="Theme" path="res://assets/pixel_ui_theme.tres" id="2_theme"]

[node name="MarketUI" type="PanelContainer"]
visible = false
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -460.0
offset_top = -250.0
offset_right = 460.0
offset_bottom = 250.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_market")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Header" type="HBoxContainer" parent="VBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Title" type="Label" parent="VBox/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.95, 0.7, 0.25, 1)
text = "UZAY TEDARİK MAĞAZASI (NSSDCA KATALOĞU)"

[node name="MarketBudgetLabel" type="Label" parent="VBox/Header"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.4, 0.95, 0.55, 1)
text = "BÜTÇE: $180M"

[node name="CloseBtn" type="Button" parent="VBox/Header"]
layout_mode = 2
text = "X KAPAT"

[node name="RocketBar" type="HBoxContainer" parent="VBox"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="RocketLbl" type="Label" parent="VBox/RocketBar"]
layout_mode = 2
text = "Fırlatma Aracı:"

[node name="RocketOption" type="OptionButton" parent="VBox/RocketBar"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
clip_text = true

[node name="Scroll" type="ScrollContainer" parent="VBox"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="PartsGrid" type="GridContainer" parent="VBox/Scroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/h_separation = 6
theme_override_constants/v_separation = 6
columns = 2

[node name="MarketStatusLabel" type="Label" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.9, 0.95, 1)
text = "Hazır"

[connection signal="pressed" from="VBox/Header/CloseBtn" to="." method="_on_close_pressed"]
[connection signal="item_selected" from="VBox/RocketBar/RocketOption" to="." method="_on_rocket_selected"]
