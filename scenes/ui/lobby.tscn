[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/lobby.gd" id="1_lobby"]
[ext_resource type="Theme" path="res://assets/pixel_ui_theme.tres" id="2_theme"]

[node name="Lobby" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_lobby")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.05, 0.07, 0.11, 1)

[node name="MarginContainer" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 8
theme_override_constants/margin_top = 6
theme_override_constants/margin_right = 8
theme_override_constants/margin_bottom = 6

[node name="MainVBox" type="VBoxContainer" parent="MarginContainer"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="TitleLabel" type="Label" parent="MarginContainer/MainVBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 12
text = "STATION 13: MISSION CONTROL — KOMUTA LOBİSİ"
horizontal_alignment = 1

[node name="Columns" type="HBoxContainer" parent="MarginContainer/MainVBox"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 6

[node name="CrewPanel" type="PanelContainer" parent="MarginContainer/MainVBox/Columns"]
clip_contents = true
layout_mode = 2
size_flags_horizontal = 3

[node name="CrewVBox" type="VBoxContainer" parent="MarginContainer/MainVBox/Columns/CrewPanel"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="CrewHeader" type="Label" parent="MarginContainer/MainVBox/Columns/CrewPanel/CrewVBox"]
layout_mode = 2
text = "1. MÜRETTEBAT (1-4)"

[node name="NicknameInput" type="LineEdit" parent="MarginContainer/MainVBox/Columns/CrewPanel/CrewVBox"]
unique_name_in_owner = true
layout_mode = 2
placeholder_text = "Komutan Adı"

[node name="AddBox" type="HBoxContainer" parent="MarginContainer/MainVBox/Columns/CrewPanel/CrewVBox"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="AddPlayerInput" type="LineEdit" parent="MarginContainer/MainVBox/Columns/CrewPanel/CrewVBox/AddBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "ID (Ali#4210)"

[node name="AddPlayerBtn" type="Button" parent="MarginContainer/MainVBox/Columns/CrewPanel/CrewVBox/AddBox"]
layout_mode = 2
text = "+ Ekle"

[node name="CrewList" type="VBoxContainer" parent="MarginContainer/MainVBox/Columns/CrewPanel/CrewVBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 3

[node name="MissionPanel" type="PanelContainer" parent="MarginContainer/MainVBox/Columns"]
clip_contents = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_stretch_ratio = 1.45

[node name="MissionVBox" type="VBoxContainer" parent="MarginContainer/MainVBox/Columns/MissionPanel"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="MissionHeader" type="Label" parent="MarginContainer/MainVBox/Columns/MissionPanel/MissionVBox"]
layout_mode = 2
text = "2. NASA GÖREV & BÜTÇE"

[node name="MissionOption" type="OptionButton" parent="MarginContainer/MainVBox/Columns/MissionPanel/MissionVBox"]
unique_name_in_owner = true
layout_mode = 2
clip_text = true

[node name="ModifierOption" type="OptionButton" parent="MarginContainer/MainVBox/Columns/MissionPanel/MissionVBox"]
unique_name_in_owner = true
layout_mode = 2
clip_text = true

[node name="LaunchSiteOption" type="OptionButton" parent="MarginContainer/MainVBox/Columns/MissionPanel/MissionVBox"]
unique_name_in_owner = true
layout_mode = 2
clip_text = true

[node name="BudgetLabel" type="Label" parent="MarginContainer/MainVBox/Columns/MissionPanel/MissionVBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.45, 0.95, 0.6, 1)
text = "DİNAMİK BÜTÇE: $180M"
clip_text = true

[node name="DescScroll" type="ScrollContainer" parent="MarginContainer/MainVBox/Columns/MissionPanel/MissionVBox"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="MissionDesc" type="Label" parent="MarginContainer/MainVBox/Columns/MissionPanel/MissionVBox/DescScroll"]
unique_name_in_owner = true
custom_minimum_size = Vector2(180, 0)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_font_sizes/font_size = 9
autowrap_mode = 3

[node name="StartBtn" type="Button" parent="MarginContainer/MainVBox/Columns/MissionPanel/MissionVBox"]
layout_mode = 2
text = "GÖREVİ BAŞLAT (SOLO / CO-OP)"

[node name="LeaderboardPanel" type="PanelContainer" parent="MarginContainer/MainVBox/Columns"]
clip_contents = true
layout_mode = 2
size_flags_horizontal = 3

[node name="LeaderVBox" type="VBoxContainer" parent="MarginContainer/MainVBox/Columns/LeaderboardPanel"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="LeaderHeader" type="Label" parent="MarginContainer/MainVBox/Columns/LeaderboardPanel/LeaderVBox"]
layout_mode = 2
text = "3. LİDERLİK TABLOSU"

[node name="LeaderboardList" type="VBoxContainer" parent="MarginContainer/MainVBox/Columns/LeaderboardPanel/LeaderVBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 3

[connection signal="text_submitted" from="MarginContainer/MainVBox/Columns/CrewPanel/CrewVBox/NicknameInput" to="." method="_on_nickname_submitted"]
[connection signal="pressed" from="MarginContainer/MainVBox/Columns/CrewPanel/CrewVBox/AddBox/AddPlayerBtn" to="." method="_on_add_player_pressed"]
[connection signal="item_selected" from="MarginContainer/MainVBox/Columns/MissionPanel/MissionVBox/MissionOption" to="." method="_on_mission_selected"]
[connection signal="item_selected" from="MarginContainer/MainVBox/Columns/MissionPanel/MissionVBox/ModifierOption" to="." method="_on_modifier_selected"]
[connection signal="item_selected" from="MarginContainer/MainVBox/Columns/MissionPanel/MissionVBox/LaunchSiteOption" to="." method="_on_launch_site_selected"]
[connection signal="pressed" from="MarginContainer/MainVBox/Columns/MissionPanel/MissionVBox/StartBtn" to="." method="_on_start_mission_pressed"]
