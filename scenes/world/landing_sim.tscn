[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/landing_sim.gd" id="1_landing"]
[ext_resource type="Theme" path="res://assets/pixel_ui_theme.tres" id="2_theme"]

[node name="LandingSim" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_landing")

[node name="BG" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.05, 0.07, 0.12, 1)

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 18
theme_override_constants/margin_top = 14
theme_override_constants/margin_right = 18
theme_override_constants/margin_bottom = 14

[node name="Panel" type="PanelContainer" parent="Margin"]
layout_mode = 2

[node name="VBox" type="VBoxContainer" parent="Margin/Panel"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="PhaseLabel" type="Label" parent="Margin/Panel/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.4, 0.85, 1.0, 1)
text = "FIRLATMA HAZIRLIĞI..."
horizontal_alignment = 1

[node name="EDLProgress" type="ProgressBar" parent="Margin/Panel/VBox"]
unique_name_in_owner = true
layout_mode = 2
max_value = 100.0

[node name="SummaryLabel" type="Label" parent="Margin/Panel/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 13
text = "SONUÇ BEKLENİYOR"
horizontal_alignment = 1

[node name="MetricsLabel" type="Label" parent="Margin/Panel/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Metrikler"
horizontal_alignment = 1

[node name="Scroll" type="ScrollContainer" parent="Margin/Panel/VBox"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="DetailsLabel" type="Label" parent="Margin/Panel/VBox/Scroll"]
unique_name_in_owner = true
custom_minimum_size = Vector2(560, 0)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
autowrap_mode = 3

[node name="ReturnLobbyBtn" type="Button" parent="Margin/Panel/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "LOBİYE DÖN"

[connection signal="pressed" from="Margin/Panel/VBox/ReturnLobbyBtn" to="." method="_on_return_lobby_pressed"]
